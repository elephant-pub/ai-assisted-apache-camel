# Design 006 D9: ConfigMap order-integration-settings for the CI kind cluster (hosts, ports, addresses; no secret).
# With the StatefulSet's own env (file paths) and the Secret order-integration-secrets (smoke.sh, random per run) these
# are the 27 variables of application-default.properties; HOSTNAME is set by Kubernetes.
KAFKA_BROKERS=kafka.trailhead-ci-systems.svc:9092
DB_HOST=postgres.trailhead-ci-systems.svc
DB_PORT=5432
DB_NAME=orders
DB_USERNAME=trailhead
CATALOG_HOST=catalog.trailhead-ci-systems.svc
CATALOG_PORT=8091
SMTP_HOST=mail.trailhead-ci-systems.svc
SMTP_PORT=1025
ORDERDESK_MAILBOX=order-desk@trailhead.example
ORDERDESK_SENDER=order-integration@trailhead.example
PARTNER_HTTP_PORT=8443
PARTNER_MAIL_SENDER=orders@trailhead.example
WAREHOUSE_SFTP_HOST=sftp.trailhead-ci-systems.svc
WAREHOUSE_SFTP_PORT=22
WAREHOUSE_SFTP_USERNAME=admin
