            <scope>test</scope>
        </dependency>
        <!-- Design 006 D11 (T7): RouteCatalogTest validates every route endpoint against the catalog of the Camel version
             in use. Not managed by the Camel Spring Boot BOM, so the version is the project's Camel version. -->
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-catalog</artifactId>
            <version>4.22.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Design 006 D11 (T7): every *.camel.yaml against the YAML DSL schema of Camel 4.22.2, in every build -->
            <plugin>
                <groupId>org.apache.camel</groupId>
                <artifactId>camel-yaml-dsl-validator-maven-plugin</artifactId>
                <version>4.22.2</version>
                <executions>
                    <execution>
                        <id>validate-routes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                        <configuration>
                            <failOnError>true</failOnError>
                            <onlyCamelYamlExt>true</onlyCamelYamlExt>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Pipeline 004: the executable spec tests run against the packaged jar, after package (design 004 §3.1, §3.10).
                 One fork, no parallel runs: the tests share containers and a mail queue. -->
            <!-- Pipeline 005 (§3.9): the test-only fault hook in its own jar (only the fault package), never in the
                 production jar; IntegrationProcess.withFaults puts it on the PropertiesLauncher loader.path. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>fault-hook-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <classifier>fault-hook</classifier>
                            <includes>
                                <include>com/trailheadgear/orderintegration/fault/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Pipeline 005 (P-10): failsafe merges into an existing summary file, so the failure ITs' summary left by an
                 earlier build (without clean) would keep its failures; it is removed before the ITs run -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-failure-it-summary</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/failsafe-reports</directory>
                                    <includes>
                                        <include>failsafe-summary-failure.xml</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*$*</exclude>
                        <exclude>**/spec/*IT.java</exclude>
                        <exclude>**/failure/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Pipeline 005 (P-11): plugin level covers both, so that a direct CLI call (execution default-cli) with
                         -Dit.test=<Class> finds a failure IT; the executions below narrow it. -->
                    <includes>
                        <include>**/spec/*IT.java</include>
                        <include>**/failure/*IT.java</include>
                    </includes>
                    <runOrder>alphabetical</runOrder>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <systemPropertyVariables>
                        <spec-test.jar>${project.build.directory}/${project.build.finalName}.jar</spec-test.jar>
                        <spec-test.docs-dir>${project.basedir}/docs</spec-test.docs-dir>
                        <spec-test.work-dir>${project.build.directory}/spec-tests</spec-test.work-dir>
                        <spec-test.fault-hook-jar>${project.build.directory}/${project.build.finalName}-fault-hook.jar</spec-test.fault-hook-jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <!-- The spec ITs run first (declaration order); the summary file keeps its default name -->
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/spec/*IT.java</include>
                            </includes>
                            <!-- verify reads both summaries (listed explicitly, so a spec failure is never dropped) -->
                            <summaryFiles>
                                <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary.xml</summaryFile>
                                <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-failure.xml</summaryFile>
                            </summaryFiles>
                        </configuration>
                    </execution>
                    <!-- Pipeline 005 (P-10): failure ITs against the packaged jar with the fault hook, after the spec ITs -->
                    <execution>
                        <id>failure-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/failure/*IT.java</include>
                            </includes>
                            <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-failure.xml</summaryFile>
                            <!-- Keeps the spec ITs' result files for the traceability matrix (SpecEnvironment) -->
                            <systemPropertyVariables>
                                <spec-test.keep-results>true</spec-test.keep-results>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Developer review of 003: docs/api/partner-orders.openapi.yaml bundled into one file at prepare-package, its
                 ../messages/*.schema.json $refs inlined, because the OpenAPI parser can't resolve relative $refs on the
                 classpath. ContractBundleTest proves the bundle says what docs/ says. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>bundle-partner-contract</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.trailheadgear.orderintegration.ContractBundle</argument>
                                <argument>${project.basedir}/docs/api/partner-orders.openapi.yaml</argument>
                                <argument>${project.build.outputDirectory}/contract/api/partner-orders.openapi.yaml</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Design 004 §3.9: completeness check and traceability matrix, after failsafe:integration-test and before
                         failsafe:verify. In-process exec:java on the test classpath; SpecMatrix fails by throwing, never System.exit. -->
                    <execution>
                        <id>spec-traceability-matrix</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <!-- -Dmaven.test.skip: the test classes are not compiled, so there is nothing to run -->
                            <skip>${maven.test.skip}</skip>
                            <mainClass>com.trailheadgear.orderintegration.spec.SpecMatrix</mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>${project.basedir}/docs</argument>
                                <argument>${project.build.directory}/spec-tests</argument>
                                <argument>${skipITs}</argument>
                                <argument>${skipTests}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- E6: the JSON schemas the routes and the partner registration validate against are copied from docs/messages/ (the single
                 source of truth) into the jar at build time; no copy is kept under src/. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-message-schemas</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/schemas</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/docs/messages</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>peakmart-order-placed.schema.json</include>
                                        <include>product.schema.json</include>
                                        <include>order.schema.json</include>
                                        <include>partner-configuration.schema.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-partner-contract-messages</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/contract/messages</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/docs/messages</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>partner-order.schema.json</include>
                                        <include>order-answer.schema.json</include>
                                        <include>rejection-reason.schema.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>camel.debug</id>
            <activation>
                <property>
                    <name>camel.debug</name>
                    <value>true</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.camel.springboot</groupId>
                    <artifactId>camel-debug-starter</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.10.0</version>
                        <executions>
                            <execution>
                                <id>copy</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                      <artifactItem>
                                        <groupId>org.jolokia</groupId>
                                        <artifactId>jolokia-agent-jvm</artifactId>
                                        <version>2.5.1</version>
                                        <type>jar</type>
                                        <classifier>javaagent</classifier>
                                      </artifactItem>
                                    </artifactItems>
                                    <stripVersion>true</stripVersion>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <jvmArguments>-javaagent:target/dependency/jolokia-agent-jvm-javaagent.jar=port=7878,host=localhost</jvmArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
