@startuml Use Cases Overview
left to right direction

' Primary actors
actor "Partner" as partner
actor "Peakmart" as peakmart
actor "Order Desk" as orderdesk
actor "Warehouse Team" as warehouse
actor "Integration Team" as integration

' Secondary actors (external systems)
actor "Product Catalog" as catalog
actor "Order Database" as orderdb
actor "Warehouse SFTP Server" as sftp

rectangle "Trailhead Order Integration" {
    usecase "UC-001\nSubmit Partner Order" as UC001
    usecase "UC-002\nTake In Peakmart Order" as UC002
    usecase "UC-003\nCheck Order" as UC003
    usecase "UC-004\nDeliver Pick List" as UC004
    usecase "UC-005\nLook Up Order" as UC005
    usecase "UC-006\nAlert on Stuck Order" as UC006
    usecase "UC-007\nRegister Partner" as UC007
    usecase "UC-008\nResubmit Set-Aside Order Event" as UC008
}

partner --> UC001
peakmart --> UC002
warehouse --> UC004
orderdesk --> UC005
integration --> UC006
integration --> UC007
integration --> UC008

UC001 ..> UC003 : <<include>>
UC002 ..> UC003 : <<include>>

UC001 --> catalog
UC001 --> orderdb
UC002 --> catalog
UC002 --> orderdb
UC002 --> orderdesk
UC003 --> catalog
UC004 --> sftp

note right of UC003
  The same Order Checks for every Channel (FR-016),
  shared by UC-001 and UC-002
end note

note right of UC008
  A resubmitted Order Event is processed like a new
  one (UC-002); the Duplicate rule prevents a second
  recording (FR-041)
end note

@enduml
